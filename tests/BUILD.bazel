load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# ── Fixture data ─────────────────────────────────────────────────────────────

filegroup(
    name = "chessmatrix_fixtures",
    srcs = glob(["fixtures/chessmatrix/**"]),
)

# ── JS tests (run under Node.js) ────────────────────────────────────────────

sh_test(
    name = "test_chessmatrix_js",
    srcs = ["run_js_test.sh"],
    args = ["tests/test_chessmatrix_js.js"],
    data = [
        "test_chessmatrix_js.js",
        ":chessmatrix_fixtures",
        "//web:chessmatrix_scanner_js",
    ],
)

sh_test(
    name = "test_sim_js",
